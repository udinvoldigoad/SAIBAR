# Salin ke frontend/.env.local (di-ignore git) lalu isi.

# Token publik Mapbox (pk.…) untuk basemap PETA UTAMA (halaman Peta Risiko).
# Kosong → peta utama memakai MapLibre + OpenStreetMap seperti biasa.
# Peta di halaman lapor/detail laporan selalu MapLibre (hemat kuota Mapbox).
# Batasi token ini di dashboard Mapbox (URL restriction) ke saibar.id & localhost.
# Dibaca saat build: untuk produksi, isi sebelum `npm run build`.
VITE_MAPBOX_TOKEN=
